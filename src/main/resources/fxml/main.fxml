<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox minHeight="560.0" minWidth="720.0" prefHeight="680.0" prefWidth="800.0" stylesheets="@../css/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>

      <!-- Header -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header">
         <children>
            <VBox spacing="2.0">
               <children>
                  <HBox alignment="BASELINE_LEFT" spacing="0.0">
                     <children>
                        <Label styleClass="app-title" text="Borderlands" />
                        <Label styleClass="app-title-accent" text="+" />
                     </children>
                  </HBox>
                  <Label styleClass="app-subtitle" text="Borderlands GOTY Enhanced trainer" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="8.0" styleClass="status-pill">
               <children>
                  <Circle radius="4.0" styleClass="status-dot" />
                  <Label styleClass="status-pill-label" text="Attached" />
               </children>
            </HBox>
         </children>
      </HBox>

      <!-- Body -->
      <VBox spacing="16.0" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
         </padding>
         <children>
            <GridPane hgap="16.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
               </columnConstraints>
               <children>

                  <!-- Cheats -->
                  <VBox spacing="10.0" styleClass="card" GridPane.columnIndex="0">
                     <children>
                        <Label styleClass="card-title" text="CHEATS">
                           <VBox.margin>
                              <Insets bottom="4.0" />
                           </VBox.margin>
                        </Label>
                        <Button fx:id="godMode" maxWidth="Infinity" mnemonicParsing="false" onMouseClicked="#toggleGodMode" styleClass="toggle-card" text="Godmode" />
                        <Button fx:id="unlimitedAmmo" maxWidth="Infinity" mnemonicParsing="false" onMouseClicked="#toggleUnlimitedAmmo" styleClass="toggle-card" text="Unlimited ammo" />
                        <Button fx:id="maxWeaponDmg" maxWidth="Infinity" mnemonicParsing="false" onMouseClicked="#toggleMaxWeaponDmg" styleClass="toggle-card" text="Max weapon dmg" />
                        <Button fx:id="noSkillCd" maxWidth="Infinity" mnemonicParsing="false" onMouseClicked="#toggleNoSkillCooldown" styleClass="toggle-card" text="No skill cooldown" />
                     </children>
                  </VBox>

                  <!-- Resources -->
                  <VBox spacing="10.0" styleClass="card" GridPane.columnIndex="1">
                     <children>
                        <Label styleClass="card-title" text="RESOURCES">
                           <VBox.margin>
                              <Insets bottom="4.0" />
                           </VBox.margin>
                        </Label>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <Label styleClass="field-label" text="XP multiplier" />
                              <Region HBox.hgrow="ALWAYS" />
                              <ComboBox fx:id="xpMult" prefWidth="130.0" promptText="1.0" />
                           </children>
                           <VBox.margin>
                              <Insets bottom="4.0" />
                           </VBox.margin>
                        </HBox>
                        <Button fx:id="maxCash" maxWidth="Infinity" mnemonicParsing="false" onMouseClicked="#maxCash" styleClass="action-button" text="Max cash" />
                        <Button fx:id="maxKeys" maxWidth="Infinity" mnemonicParsing="false" onMouseClicked="#maxKeys" styleClass="action-button" text="Max golden keys" />
                        <Button fx:id="resetShops" maxWidth="Infinity" mnemonicParsing="false" onMouseClicked="#resetShops" styleClass="action-button" text="Reset shops" />
                     </children>
                  </VBox>
               </children>
            </GridPane>

            <!-- Console -->
            <VBox spacing="8.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label styleClass="card-title" text="LOG" />
                  <TextArea fx:id="prompt" editable="false" styleClass="console" wrapText="true" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</VBox>
